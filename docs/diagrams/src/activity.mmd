---
title: "Activity diagram - quy trinh nghiep vu 6 lan trach nhiem"
---
flowchart TB
  classDef step fill:#eef6fb,stroke:#3d9bd1,color:#0c3a55
  classDef dec fill:#fff7e0,stroke:#e0a800,color:#5c4400
  classDef sys fill:#f3eefb,stroke:#7b5ea7,color:#33235a
  classDef endcls fill:#fdecea,stroke:#c0392b,color:#7c1d15

  subgraph L2["Lễ tân (receptionist)"]
    direction TB
    R0(["Mở ca<br/>POST /shifts/open"]):::step
    R1(["Check-in lịch hẹn hoặc tiếp nhận trực tiếp<br/>POST /appointments/:id/check-in<br/>POST /repair-jobs"]):::step
    R2(["Khách và xe đã có?<br/>chọn hồ sơ, chưa có thì tạo mới"]):::dec
    R3(["Phân công thợ máy<br/>PUT /repair-jobs/:id/assign"]):::step
    R4(["Lập báo giá sau khi phân công<br/>POST /estimates"]):::step
    R5(["Lập hóa đơn cho phiếu completed<br/>POST /invoices"]):::step
    R6(["Ghi nhận thanh toán<br/>PUT /invoices/:id/pay"]):::step
    R7(["Kiểm kê ba phương thức, chốt ca<br/>POST /shifts/close"]):::step
    RX(["Chốt ca bị chặn 409<br/>nếu còn phiếu chi pending"]):::endcls
    R0 --> R1 --> R2 --> R3 --> R4 --> R5 --> R6 --> R7 --> RX
  end

  subgraph L6["Hệ thống (tự động)"]
    direction TB
    S1(["create_repair_job_with_services<br/>tạo phiếu status pending"]):::sys
    S2(["trigger sau bản ghi phân công<br/>pending sang diagnosing"]):::sys
    S3(["estimate.service chuyển estimated, approved,<br/>khách từ chối thì cancelled"]):::sys
    S4(["used_parts, inventory_movements, stock_quantity<br/>cùng transaction với SELECT FOR UPDATE"]):::sys
    S5(["cash_transactions ghi theo ca,<br/>chỉ dòng approved cộng vào total_cash_outflow"]):::sys
    S6(["closeShift tính expected_closing_cash,<br/>cash_difference và giải trình khi lệch quá 0,009 đồng"]):::sys
    S7(["customer_notifications<br/>và GET /notifications"]):::sys
  end

  subgraph L4["Thợ máy (mechanic)"]
    direction TB
    T1(["Nhận phiếu của mình<br/>GET /repair-jobs/my-jobs"]):::step
    T2(["Chẩn đoán và đề xuất<br/>PUT /repair-jobs/:id/diagnosis"]):::step
    T3(["Bắt đầu sửa chữa<br/>PUT /repair-jobs/:id/status in_repair"]):::step
    T4(["Ghi nhận phụ tùng đã dùng<br/>POST /spare-parts/:id/deduct"]):::step
    T5(["Hoàn thành sửa chữa<br/>status completed"]):::step
    T1 --> T2 --> T3 --> T4 --> T5
  end

  subgraph L5["Nhân viên kho (warehouse_staff)"]
    direction TB
    W1(["Xem tồn kho và cảnh báo dưới ngưỡng<br/>GET /spare-parts/low-stock"]):::step
    W2(["Nhập kho phụ tùng<br/>POST /spare-parts/:id/import"]):::step
    W3(["Hoàn trả phụ tùng ghi nhầm<br/>DELETE /spare-parts/usage/:usedPartId"]):::step
  end

  subgraph L3["Quản lý dịch vụ (service_manager)"]
    direction TB
    M1(["Duyệt phiếu chi vượt hạn mức<br/>POST /shifts/transactions/:transactionId/decision"]):::dec
    M2(["Pay-in và pay-out quỹ<br/>POST /shifts/cash-movements"]):::step
    M3(["Chi trả công nợ nhập kho<br/>POST /shifts/inventory-payables/:payableId/payout"]):::step
  end

  subgraph L1["Khách hàng (customer)"]
    direction TB
    K1(["Đặt lịch hẹn<br/>POST /appointments"]):::step
    K2(["Chờ xác nhận giờ và nhận thông báo"]):::step
    K3(["Duyệt hoặc từ chối báo giá<br/>PUT /estimates/:id/approve hoặc /reject"]):::dec
    K4(["Nhận xe và hóa đơn đã thanh toán"]):::step
    K1 --> K2 --> K3
  end

  K1 --> R1
  R2 --> S1
  S1 --> R3
  R3 --> S2
  S2 --> T1
  T2 --> R4
  R4 --> S3
  S3 --> K3
  K3 -->|duyệt| T3
  T4 --> S4
  S4 --> W1
  W1 -->|dưới min_stock| W2
  W2 --> S4
  T4 -->|ghi nhầm| W3
  S4 --> T5
  T5 --> R5
  R6 --> S5
  S5 --> M1
  M1 -->|approved| M2
  M2 --> S5
  M3 --> S5
  S5 --> R7
  R7 --> S6
  S6 --> K4
  S7 --> K2
