# ============================================================
# .env.example — FILE MẪU CẤU HÌNH. Không chứa bất kỳ bí mật thật nào.
#
# Cách dùng:
#   1. Copy file này thành `.env` ở cùng thư mục.
#   2. Điền giá trị thực tế của máy bạn vào `.env`.
#   3. KHÔNG commit `.env` — file .env đã được loại bỏ trong .gitignore.
#
# File .env ở thư mục gốc được docker-compose đọc để thay thế ${...}.
# Backend đọc theo thứ tự: biến môi trường hệ thống -> backend/.env -> .env gốc.
# ============================================================

# --- Cổng phát động backend ---
PORT=3000

# --- Kết nối PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=thay_bang_ten_user_database_cua_ban
DB_PASSWORD=thay_bang_mat_khau_cua_ban
DB_NAME=workshop_db

# --- Tài khoản superuser: CHỈ dùng cho script khởi tạo database (setupDb.js) ---
DB_SUPERUSER=postgres
DB_SUPERDATABASE=postgres
DB_SUPERUSER_PASSWORD=thay_bang_mat_khau_postgres_cua_ban

# --- JWT ---
# JWT_SECRET phải là chuỗi ngẫu nhiên dài (tối thiểu 32 ký tự). Không dùng lại giá trị mẫu.
JWT_SECRET=thay_bang_chuoi_ngau_nhien_toi_thieu_32_ky_tu
JWT_EXPIRES_IN=8h

# --- Nghiệp vụ ---
# Tỷ lệ thuế VAT dùng khi xuất hóa đơn. 0.10 = 10%. Giá trị 0 được phép.
VAT_RATE=0.10

# --- Frontend (Vite) ---
# LƯU Ý: mọi biến VITE_* được đóng gói vào file JS gửi xuống trình duyệt,
# ai cũng có thể xem được. CHỈ đưa giá trị công khai vào đây.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_ORIGIN=http://localhost:3000
