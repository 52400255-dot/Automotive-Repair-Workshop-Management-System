# ============================================================
# frontend/.env.example — FILE MẪU. Copy thành frontend/.env nếu cần đổi.
#
# Chi chua gia tri CONG KHAI. Ma frontend duoc dong goi va gui xuong trinh
# duyet, nen mat khau database / JWT_SECRET tuyet doi khong duoc dat o day.
# ============================================================

# Noi backend API chay (proxy dev cua Vite tro toi day).
VITE_BACKEND_ORIGIN=http://localhost:3000

# Cang dev server cua frontend.
VITE_DEV_SERVER_PORT=5173
